{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://hiredtodayapp.com"
  },
  "crons": [
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/auto-apply",
      "schedule": "0 6 * * *"
    }
  ]
}
